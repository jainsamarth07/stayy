# Environment
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://staynest:staynest_secret@localhost:5432/staynest
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=CHANGE-ME-use-openssl-rand-hex-64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# S3-Compatible Storage (MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=staynest-images
S3_REGION=us-east-1

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1

# Webhook
WEBHOOK_SECRET=CHANGE-ME-webhook-secret

# Email
EMAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@staynest.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
