# ─── StayNest — Root environment file ───
# Copy to .env and fill in real values before running docker compose.
#
#   cp .env.example .env
#   openssl rand -hex 64   # → paste into JWT_SECRET_KEY
#   openssl rand -base64 32 # → paste into BETTER_AUTH_SECRET & WEBHOOK_SECRET
#
# .env is git-ignored. NEVER commit real secrets.

# ── General ──
APP_ENV=production
DOMAIN=staynest.example.com          # Your production domain

# ── Postgres ──
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ── Redis ──
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# ── JWT / Auth ──
JWT_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_64
WEBHOOK_SECRET=CHANGE_ME_use_openssl_rand_base64_32
BETTER_AUTH_SECRET=CHANGE_ME_use_openssl_rand_base64_32

# ── S3 / MinIO ──
MINIO_ROOT_USER=CHANGE_ME_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_secret
S3_ACCESS_KEY_ID=CHANGE_ME_minio_admin
S3_SECRET_ACCESS_KEY=CHANGE_ME_minio_secret

# ── Email (SMTP) ──
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=noreply@staynest.example.com
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_FROM=noreply@staynest.example.com

# ── Frontend ──
NEXT_PUBLIC_API_URL=https://staynest.example.com/api/v1
NEXT_PUBLIC_APP_URL=https://staynest.example.com
NEXT_PUBLIC_MAPBOX_TOKEN=pk.CHANGE_ME

# ── AI Agent (optional) ──
GROQ_API_KEY=
